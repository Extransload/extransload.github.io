---
import BlogLayout from '../../../domains/blog/layouts/BlogLayout.astro';
import ArchiveView from '../../../domains/blog/components/ArchiveView.astro';
import { postsGroupedBy } from '../../../domains/blog/content/archive';

export async function getStaticPaths() {
  const groups = await postsGroupedBy((post) => [post.data.category]);
  return [...groups].map(([category, posts]) => ({ params: { category }, props: { category, posts } }));
}

const { category, posts } = Astro.props;
const basePath = `/blog/categories/${encodeURIComponent(category)}`;
---

<BlogLayout
  title={`${category} 글 — Extransload`}
  description={`${category} 카테고리의 글`}
  canonicalPath={`${basePath}/`}
>
  <ArchiveView
    eyebrow="Category"
    heading={category}
    summary={`${posts.length}개의 기록`}
    posts={posts}
    currentPage={1}
    basePath={basePath}
  />
</BlogLayout>
