---
import BlogLayout from '../../../../domains/blog/layouts/BlogLayout.astro';
import ArchiveView from '../../../../domains/blog/components/ArchiveView.astro';
import { overflowPages, pageCount, postsGroupedBy } from '../../../../domains/blog/content/archive';

export async function getStaticPaths() {
  const groups = await postsGroupedBy((post) => [post.data.category]);
  return [...groups].flatMap(([category, posts]) =>
    overflowPages(posts.length).map((page) => ({
      params: { category, page: String(page) },
      props: { category, posts, currentPage: page },
    })),
  );
}

const { category, posts, currentPage } = Astro.props;
const basePath = `/blog/categories/${encodeURIComponent(category)}`;
---

<BlogLayout
  title={`${category} 글 ${currentPage} — Extransload`}
  description={`${category} 카테고리의 글`}
  canonicalPath={`${basePath}/${currentPage}/`}
>
  <ArchiveView
    eyebrow="Category"
    heading={category}
    summary={`${currentPage} / ${pageCount(posts.length)} 페이지 · ${posts.length}개의 기록`}
    posts={posts}
    currentPage={currentPage}
    basePath={basePath}
  />
</BlogLayout>
