---
import BlogLayout from '../../../domains/blog/layouts/BlogLayout.astro';
import ArchiveView from '../../../domains/blog/components/ArchiveView.astro';
import { overflowPages, pageCount, publishedPosts } from '../../../domains/blog/content/archive';

export async function getStaticPaths() {
  const posts = await publishedPosts();
  return overflowPages(posts.length).map((page) => ({
    params: { page: String(page) },
    props: { currentPage: page, posts },
  }));
}

const { currentPage, posts } = Astro.props;
---

<BlogLayout
  title={`글 목록 ${currentPage} — Extransload`}
  description="Extransload의 모든 기록"
  canonicalPath={`/blog/posts/${currentPage}/`}
>
  <ArchiveView
    eyebrow="Posts"
    heading="모든 글"
    summary={`${currentPage} / ${pageCount(posts.length)} 페이지 · 시간순 기록`}
    posts={posts}
    currentPage={currentPage}
    basePath="/blog/posts"
  />
</BlogLayout>
