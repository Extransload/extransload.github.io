---
import BlogLayout from '../../../domains/blog/layouts/BlogLayout.astro';
import ArchiveView from '../../../domains/blog/components/ArchiveView.astro';
import { publishedPosts } from '../../../domains/blog/content/archive';

const posts = await publishedPosts();
---

<BlogLayout title="글 목록 — Extransload" description="Extransload의 모든 기록" canonicalPath="/blog/posts/">
  <ArchiveView
    eyebrow="Archive"
    heading="모든 글"
    summary={`${posts.length}개의 기록을 시간순으로 모았습니다.`}
    posts={posts}
    currentPage={1}
    basePath="/blog/posts"
  />
</BlogLayout>
