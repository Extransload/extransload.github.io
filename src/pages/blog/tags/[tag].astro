---
import BlogLayout from '../../../domains/blog/layouts/BlogLayout.astro';
import ArchiveView from '../../../domains/blog/components/ArchiveView.astro';
import { postsGroupedBy } from '../../../domains/blog/content/archive';

export async function getStaticPaths() {
  const groups = await postsGroupedBy((post) => post.data.tags);
  return [...groups].map(([tag, posts]) => ({ params: { tag }, props: { tag, posts } }));
}

const { tag, posts } = Astro.props;
const basePath = `/blog/tags/${encodeURIComponent(tag)}`;
---

<BlogLayout title={`#${tag} 글 — Extransload`} description={`${tag} 태그의 글`} canonicalPath={`${basePath}/`}>
  <ArchiveView
    eyebrow="Tag"
    heading={`#${tag}`}
    summary={`${posts.length}개의 기록`}
    posts={posts}
    currentPage={1}
    basePath={basePath}
  />
</BlogLayout>
