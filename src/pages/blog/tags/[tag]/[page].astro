---
import BlogLayout from '../../../../domains/blog/layouts/BlogLayout.astro';
import ArchiveView from '../../../../domains/blog/components/ArchiveView.astro';
import { overflowPages, pageCount, postsGroupedBy } from '../../../../domains/blog/content/archive';

export async function getStaticPaths() {
  const groups = await postsGroupedBy((post) => post.data.tags);
  return [...groups].flatMap(([tag, posts]) =>
    overflowPages(posts.length).map((page) => ({
      params: { tag, page: String(page) },
      props: { tag, posts, currentPage: page },
    })),
  );
}

const { tag, posts, currentPage } = Astro.props;
const basePath = `/blog/tags/${encodeURIComponent(tag)}`;
---

<BlogLayout
  title={`#${tag} 글 ${currentPage} — Extransload`}
  description={`${tag} 태그의 글`}
  canonicalPath={`${basePath}/${currentPage}/`}
>
  <ArchiveView
    eyebrow="Tag"
    heading={`#${tag}`}
    summary={`${currentPage} / ${pageCount(posts.length)} 페이지 · ${posts.length}개의 기록`}
    posts={posts}
    currentPage={currentPage}
    basePath={basePath}
  />
</BlogLayout>
