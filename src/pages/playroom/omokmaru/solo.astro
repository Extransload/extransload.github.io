---
import '../../../domains/games/renju/playroom.css';
import '../../../domains/games/renju/solo.css';
import '../../../domains/games/styles/door.css';
import DoorIcon from '../../../domains/games/components/DoorIcon.astro';
import SeoHead from '../../../shared/components/SeoHead.astro';
---

<!doctype html>
<html lang="ko">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#101e2d" />
    <title>AI 대국 · 오목마루 Omokmaru — Extransload</title>
    <SeoHead title="AI 대국 · 오목마루 Omokmaru — Extransload" description="3D 바둑판에서 AI와 오목 대국" canonicalPath="/playroom/omokmaru/solo/" />
    <link rel="icon" type="image/png" href="/favicon.png" />
  </head>
  <body class="solo-play">
    <main class="game">
      <section class="stage" aria-label="3D 렌주 바둑판">
        <div class="stage-mast"><a class="door-control" href="/playroom/omokmaru/" aria-label="오목마루 로비로 돌아가기" title="로비로 나가기"><DoorIcon /></a></div>
        <div class="toolbar" role="toolbar" aria-label="바둑판 조작">
          <button id="view" title="위에서 보기" aria-label="위에서 보기">▦</button>
          <button id="zoom-in" title="확대" aria-label="확대">＋</button>
          <button id="zoom-out" title="축소" aria-label="축소">−</button>
          <button id="reset" title="시점 초기화" aria-label="시점 초기화">↺</button>
          <button id="rules" title="렌주 규칙" aria-label="렌주 규칙">☷</button>
          <button id="help" title="조작 방법" aria-label="조작 방법">?</button>
        </div>
        <div id="canvas" class="canvas"></div>
        <div id="move-confirm" class="move-confirm" hidden><button id="place-move" class="place-move" type="button" disabled><span class="confirm-stone" aria-hidden="true"></span><span id="place-label">자리 선택</span></button><button id="cancel-move" class="cancel-move" type="button" aria-label="선택 취소" title="선택 취소" hidden>×</button></div>
        <div id="stage-overlay" class="stage-overlay" hidden aria-live="polite"><div class="overlay-card"><span id="overlay-kicker"></span><strong id="overlay-title"></strong><small id="overlay-subtitle"></small></div></div>
        <div id="forbidden-tip" class="forbidden-tip" hidden></div>
        <div id="board-help" class="board-help" hidden>왼쪽 클릭: 바로 착수<br />한 손가락: 자리 선택 후 착수 버튼<br />휠 버튼을 누르고 드래그: 회전<br />두 손가락 이동: 회전<br />휠 · 두 손가락 벌리기: 확대<br />오른쪽 클릭 드래그: 이동</div>
        <div id="stage-hint" class="stage-hint"></div>
      </section>
      <aside class="side">
        <h1 class="side-title">Omokmaru</h1>
        <div class="side-top"><span class="connection-dot connected"></span><span id="status" role="status">AI 대국 준비</span></div>
        <div class="players">
          <div id="black-player" class="player"><span class="piece black"></span><div class="player-copy"><span class="player-badge">흑</span><strong id="black-name">나</strong><small id="black-detail">준비 중</small></div></div>
          <div id="white-player" class="player"><span class="piece white"></span><div class="player-copy"><span class="player-badge">백</span><strong id="white-name">AI</strong><small id="white-detail">준비 중</small></div></div>
        </div>
        <div class="solo-settings">
          <strong>AI 대국</strong>
          <div class="solo-field"><span>내 돌</span><div class="segmented"><button id="side-black" class="selected" type="button">● 흑</button><button id="side-white" type="button">○ 백</button></div></div>
          <label class="solo-field"><span>난이도</span><select id="difficulty"><option value="easy">쉬움</option><option value="normal" selected>보통</option><option value="hard">어려움</option><option value="master">마스터</option></select></label>
          <button id="start" class="primary">대국 시작</button>
          <button id="resign-solo" class="secondary" hidden>기권</button>
          <button id="undo" class="secondary" hidden>↶ 한 수 되돌리기</button>
        </div>
        <div id="replay" class="replay" hidden><div class="replay-title"><span>기보</span><span id="move-count">0 / 0</span></div><div class="replay-controls"><button id="prev" title="이전 수" aria-label="이전 수">‹</button><strong id="move-label">시작</strong><button id="next" title="다음 수" aria-label="다음 수">›</button></div></div>
        <div class="side-spacer"></div>
        <a class="secondary solo-online" href="/playroom/omokmaru/">사람과 대국하기 ↗</a>
      </aside>
    </main>
    <dialog id="rules-dialog" class="rules-dialog" aria-labelledby="rules-title"><button id="rules-close" class="dialog-close" aria-label="닫기">×</button><div class="rules-heading"><h2 id="rules-title">렌주 규칙</h2><span id="rules-count"></span></div><div id="rules-visual" class="rules-visual" role="img"></div><span id="rules-tag" class="rules-tag"></span><h3 id="rules-slide-title"></h3><p id="rules-slide-body"></p><div class="rules-nav"><button id="rules-prev" aria-label="이전 규칙">‹</button><div id="rules-dots" class="rules-dots"></div><button id="rules-next" aria-label="다음 규칙">›</button></div><a class="rules-source" href="https://gomoku.renju.net/rifrules/" target="_blank" rel="noopener noreferrer">RIF 공식 규칙 ↗</a></dialog>
    <script>import '../../../domains/games/renju/solo';</script>
  </body>
</html>
