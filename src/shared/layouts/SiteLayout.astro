---
import '../styles/tokens.css';
import '../styles/global.css';
import '../themes/midnight.css';
import '../themes/light.css';
import Header from '../components/Header.astro';
import FeatureBundle from '../components/FeatureBundle.astro';
import PageLoader from '../components/PageLoader.astro';
import ScrollProgress from '../components/ScrollProgress.astro';
import SearchModal from '../components/SearchModal.astro';
import Footer from '../components/Footer.astro';
import ImageLightbox from '../components/ImageLightbox.astro';
import Analytics from '../components/Analytics.astro';
import SeoHead from '../components/SeoHead.astro';
import { earlySidebarScript, earlyThemeScript } from '../scripts/theme-init';

interface Props {
  title: string;
  description?: string;
  canonicalPath?: string;
  robots?: string;
  schemaType?: 'WebSite' | 'WebPage' | 'Article';
  publishedTime?: Date;
  modifiedTime?: Date;
}

const {
  title,
  description = '기록하고, 더 나은 답을 찾습니다.',
  canonicalPath = '/',
  robots = 'index, follow',
  schemaType = 'WebPage',
  publishedTime,
  modifiedTime,
} = Astro.props;
---

<!doctype html>
<html lang="ko" data-theme="midnight">
  <head>
    <script is:inline set:html={earlyThemeScript}></script>
    <script is:inline set:html={earlySidebarScript}></script>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <SeoHead
      title={title}
      description={description}
      canonicalPath={canonicalPath}
      robots={robots}
      schemaType={schemaType}
      publishedTime={publishedTime}
      modifiedTime={modifiedTime}
    />
    <link rel="preload" as="image" href="/splash-leather-cover-texture.webp" fetchpriority="high" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="anonymous" />
    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@500;600;700&family=Noto+Serif+KR:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="shortcut icon" href="/favicon.ico" />
    <title>{title}</title>
    <Analytics />
    <slot name="head" />
  </head>
  <body>
    <PageLoader />
    <ScrollProgress />
    <div class="site-frame">
      <Header />
      <div class="site-content">
        <slot />
        <Footer />
      </div>
    </div>
    <SearchModal />
    <ImageLightbox />
    <FeatureBundle />
    <slot name="body-end" />
  </body>
</html>
