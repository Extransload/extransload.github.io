---
---

<dialog class="image-lightbox" aria-label="이미지 크게 보기">
  <div class="image-lightbox__toolbar">
    <span class="image-lightbox__counter" data-lightbox-counter aria-live="polite" hidden></span>
    <button type="button" data-lightbox-zoom-out aria-label="축소">
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14" /></svg>
    </button>
    <button type="button" data-lightbox-zoom-in aria-label="확대">
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 5v14M5 12h14" /></svg>
    </button>
    <button type="button" data-lightbox-close aria-label="닫기">
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m6 6 12 12M18 6 6 18" /></svg>
    </button>
  </div>

  <button type="button" class="image-lightbox__step" data-lightbox-prev aria-label="이전 이미지" hidden>
    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m15 5-7 7 7 7" /></svg>
  </button>
  <div class="image-lightbox__stage" data-lightbox-stage>
    <img class="image-lightbox__img" alt="" decoding="async" />
    <p class="image-lightbox__error">이미지를 불러오지 못했습니다.</p>
  </div>
  <button type="button" class="image-lightbox__step" data-lightbox-next aria-label="다음 이미지" hidden>
    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m9 5 7 7-7 7" /></svg>
  </button>

  <p class="image-lightbox__caption" data-lightbox-caption hidden></p>
</dialog>

<script>
  import { initializeLightbox } from '../scripts/lightbox';

  initializeLightbox();
</script>

<style is:global>
  img[data-zoomable] {
    cursor: zoom-in;
  }

  body.lightbox-open {
    overflow: hidden;
  }

  dialog.image-lightbox {
    display: none;
    width: 100vw;
    max-width: 100vw;
    height: 100dvh;
    max-height: 100dvh;
    padding: 0;
    border: 0;
    background: transparent;
  }

  dialog.image-lightbox[open] {
    display: grid;
    grid-template-columns: auto 1fr auto;
    grid-template-rows: auto 1fr auto;
    align-items: center;
  }

  dialog.image-lightbox::backdrop {
    background: rgb(0 0 0 / 88%);
  }

  .image-lightbox__toolbar {
    display: flex;
    grid-column: 1 / -1;
    align-items: center;
    justify-content: flex-end;
    gap: 0.5rem;
    padding: 0.75rem 1rem;
    color: #fff;
  }

  .image-lightbox__counter {
    margin-right: auto;
    font-family: var(--font-mono);
    font-size: 0.85rem;
    opacity: 0.85;
  }

  .image-lightbox__toolbar :is(button, a) {
    display: grid;
    width: 2.25rem;
    height: 2.25rem;
    border: 0;
    border-radius: 999px;
    color: inherit;
    background: rgb(255 255 255 / 12%);
    padding: 0;
    line-height: 1;
    text-decoration: none;
    cursor: pointer;
    place-items: center;
  }

  .image-lightbox__toolbar :is(button, a):hover,
  .image-lightbox__toolbar :is(button, a):focus-visible {
    background: rgb(255 255 255 / 24%);
  }

  .image-lightbox__step {
    display: grid;
    width: 2.75rem;
    height: 2.75rem;
    margin: 0 0.75rem;
    padding: 0;
    border: 0;
    border-radius: 999px;
    color: #fff;
    background: rgb(255 255 255 / 12%);
    cursor: pointer;
    place-items: center;
  }

  .image-lightbox__step:hover:not([disabled]),
  .image-lightbox__step:focus-visible {
    background: rgb(255 255 255 / 24%);
  }

  /* 아이콘은 모두 같은 규격의 선 아이콘. 상자 한가운데 정확히 놓이도록 블록으로 둔다. */
  .image-lightbox :is(.image-lightbox__toolbar, .image-lightbox__step) svg {
    display: block;
    width: 1.15rem;
    height: 1.15rem;
    fill: none;
    stroke: currentcolor;
    stroke-width: 1.75;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .image-lightbox__step svg {
    width: 1.4rem;
    height: 1.4rem;
  }

  .image-lightbox__step[disabled] {
    opacity: 0.35;
    cursor: default;
  }

  .image-lightbox__stage {
    display: grid;
    overflow: hidden;
    width: 100%;
    height: 100%;
    touch-action: none;
    place-items: center;
  }

  .image-lightbox__stage[data-zoomed='true'] {
    cursor: grab;
  }

  .image-lightbox__stage:not([data-zoomed='true']) {
    cursor: zoom-out;
  }

  .image-lightbox__img {
    max-width: none;
    transform-origin: center;
    will-change: transform;
  }

  .image-lightbox__error {
    display: none;
    color: #fff;
  }

  dialog.image-lightbox[data-error='true'] .image-lightbox__img {
    display: none;
  }

  dialog.image-lightbox[data-error='true'] .image-lightbox__error {
    display: block;
  }

  .image-lightbox__caption {
    grid-column: 1 / -1;
    margin: 0;
    padding: 0.85rem 1.25rem 1.5rem;
    color: rgb(255 255 255 / 82%);
    font-size: 0.92rem;
    line-height: 1.6;
    text-align: center;
    word-break: keep-all;
  }

  @media (max-width: 720px) {
    /* 화살표가 그리드에서 빠지므로 스테이지가 남은 한 칸으로 몰리지 않게 전폭을 준다. */
    .image-lightbox__stage {
      grid-column: 1 / -1;
    }

    .image-lightbox__caption {
      position: relative;
      z-index: 2;
      padding-inline: 4.5rem;
    }

    .image-lightbox__step {
      position: fixed;
      bottom: 1.25rem;
      z-index: 1;
    }

    [data-lightbox-prev] {
      left: 1rem;
    }

    [data-lightbox-next] {
      right: 1rem;
    }
  }
</style>
