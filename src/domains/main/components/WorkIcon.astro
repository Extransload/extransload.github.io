---
interface Props {
  name: 'problem' | 'work' | 'decision' | 'outcome' | 'patent' | 'citewell' | 'danchu' | 'degureure';
  class?: string;
}

const { name, class: className } = Astro.props;
---

<svg
  class:list={['work-icon', className]}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.4"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
>
  {name === 'problem' && (
    <>
      <circle cx="12" cy="12" r="9" />
      <path d="M9.4 9.2a2.6 2.6 0 0 1 5.05.85c0 1.73-2.45 2.45-2.45 3.95" />
      <path d="M12 17.3h.01" />
    </>
  )}

  {name === 'work' && (
    <>
      <path d="M3.5 7.5 12 3l8.5 4.5L12 12 3.5 7.5Z" />
      <path d="M3.5 12 12 16.5 20.5 12" />
      <path d="M3.5 16.5 12 21l8.5-4.5" />
    </>
  )}

  {name === 'decision' && (
    <>
      <path d="M12 21V11" />
      <path d="M12 11 6.5 6.2" />
      <path d="M12 11l5.5-4.8" />
      <circle cx="12" cy="11" r="1.6" />
      <circle cx="5.4" cy="4.8" r="1.9" />
      <circle cx="18.6" cy="4.8" r="1.9" />
    </>
  )}

  {name === 'outcome' && (
    <>
      <path d="M3.5 17.5 9 11.8l3.4 3.2 8.1-8.4" />
      <path d="M15.6 6.6h5v5" />
    </>
  )}

  {name === 'patent' && (
    <>
      <circle cx="12" cy="9.2" r="5.7" />
      <path d="M9.6 7.2h2.6a1.9 1.9 0 0 1 0 3.8H9.6V7.2Zm0 3.8v2.4" />
      <path d="M8.3 14.4 6.6 21l5.4-2.6L17.4 21l-1.7-6.6" />
    </>
  )}

  {name === 'citewell' && (
    <>
      <path d="M6 3.5h8.5L19 8v12.5H6z" />
      <path d="M14 3.5V8h5" />
      <path d="M8.8 12.4h6.4M8.8 15.6h4.2" />
    </>
  )}

  {name === 'danchu' && (
    <>
      <rect x="3.4" y="5.2" width="17.2" height="13.6" rx="1.4" />
      <path d="M3.4 9.6h17.2" />
      <path d="M6.6 12.9h4.2v3.1H6.6z" />
      <path d="M13.6 13.2h4.4M13.6 16h2.8" />
    </>
  )}

  {name === 'degureure' && (
    <>
      <circle cx="8.6" cy="12" r="5.6" />
      <circle cx="15.4" cy="12" r="5.6" />
      <path d="M6.7 13.4a2.6 2.6 0 0 0 3.8 0" />
      <path d="M13.5 13.4a2.6 2.6 0 0 0 3.8 0" />
    </>
  )}
</svg>
