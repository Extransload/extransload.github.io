---
import MainSpaceLayout from '../layouts/MainSpaceLayout.astro';
import { works, patents, type WorkProject } from '../data/work-archive';
import '../styles/work-doc.css';

interface Props {
  project: WorkProject;
}

const { project } = Astro.props;
const position = works.findIndex((entry) => entry.slug === project.slug);
const previous = position > 0 ? works[position - 1] : null;
const next = position < works.length - 1 ? works[position + 1] : null;
const milestoneFor = (n: string) => project.milestones.find((m) => m.after === n);
---

<MainSpaceLayout
  title={`${project.title} — Works — Extransload`}
  description={project.subtitle}
  canonicalPath={`/works/${project.slug}/`}
>
  <main class="work-doc" aria-labelledby="work-title" data-work-doc>
    <div class="work-doc__shell">
      <nav class="work-doc__rail" aria-label="장 목차">
        <a class="work-doc__back" href="/works/">← 목차로 돌아가기</a>
        <b>이 문서</b>
        {project.chapters.map((chapter) => (
          <a href={`#ch-${chapter.n}`} data-rail-link={`ch-${chapter.n}`}>
            <i>{chapter.n}</i><span>{chapter.title}</span>
          </a>
        ))}
      </nav>

      <article>
        <header>
          <p class="work-doc__eyebrow">{project.folio} · {project.context}</p>
          <h1 id="work-title">{project.title}</h1>
          <p class="work-doc__sub">{project.subtitle}</p>

          <dl class="work-doc__facts">
            <div><dt>기간</dt><dd>{project.period}</dd></div>
            <div><dt>역할</dt><dd>{project.role}</dd></div>
            {project.metrics.slice(2).map((metric) => (
              <div><dt>{metric.label}</dt><dd>{metric.value}</dd></div>
            ))}
          </dl>

          <p class="work-doc__summary">{project.summary}</p>
          <p class="work-doc__stack">{project.stack}</p>
          {project.links.length > 0 && (
            <p class="work-doc__links">
              {project.links.map((link) => (
                <a href={link.href} target="_blank" rel="noreferrer">{link.label} ↗</a>
              ))}
            </p>
          )}
        </header>

        {project.gallery.length > 0 && (
          <section class="work-doc__shots" aria-label={`${project.title} 화면`}>
            {project.gallery.map((shot) => (
              <figure>
                <img src={shot.src} alt={shot.alt} loading="lazy" decoding="async" />
                <figcaption>{shot.caption}</figcaption>
              </figure>
            ))}
          </section>
        )}

        {project.chapters.map((chapter) => (
          <>
            <section aria-labelledby={`ch-${chapter.n}`} data-chapter={chapter.n}>
              <h2 id={`ch-${chapter.n}`}>
                <span class="work-doc__n">{chapter.n}</span>{chapter.title}
                <small>{chapter.period}</small>
              </h2>

              <p class="work-doc__lede">{chapter.lede}</p>

              <h3>요구사항</h3>
              <dl class="work-req">
                {chapter.requirements.map((req) => (
                  <div><dt>{req.label}</dt><dd>{req.value}</dd></div>
                ))}
              </dl>

              <h3>구현</h3>
              <ol class="work-build">
                {chapter.build.map((step) => (
                  <li>
                    <h4>
                      {step.head}
                      {step.decision && <span class="work-build__tag">설계 판단</span>}
                    </h4>
                    <ul>
                      {step.body.map((line) => <li>{line}</li>)}
                    </ul>
                  </li>
                ))}
              </ol>

              {chapter.hard.length > 0 && (
                <>
                  <h3>까다로웠던 지점</h3>
                  {chapter.hard.map((item) => (
                    <div class="work-friction">
                      <h4>{item.head}</h4>
                      <p>{item.body}</p>
                      <p class="work-friction__fix"><b>해결</b>{item.resolved}</p>
                    </div>
                  ))}
                </>
              )}

              <h3>남긴 것</h3>
              <ul class="work-outcome">
                {chapter.outcome.map((line) => <li>{line}</li>)}
              </ul>
            </section>

            {milestoneFor(chapter.n) && (
              <aside class="work-milestone">
                <h3>{milestoneFor(chapter.n)!.label}</h3>
                <p>{milestoneFor(chapter.n)!.body}</p>
              </aside>
            )}
          </>
        ))}

        {project.slug === 'citewell' && (
          <section aria-labelledby="patents-title">
            <h2 id="patents-title">출원 특허</h2>
            <ul class="work-patents">
              {patents.map((patent) => (
                <li>
                  <p class="work-patents__scope">{patent.scope}</p>
                  <p class="work-patents__title">{patent.title}</p>
                  <p class="work-patents__note">{patent.note}</p>
                </li>
              ))}
            </ul>
          </section>
        )}

        <nav class="work-doc__nav" aria-label="다른 작업">
          {previous ? (
            <a href={`/works/${previous.slug}/`}>
              <span>← 이전 기록</span><b>{previous.title}</b>
            </a>
          ) : <span></span>}
          {next ? (
            <a href={`/works/${next.slug}/`}>
              <span>다음 기록 →</span><b>{next.title}</b>
            </a>
          ) : <span></span>}
        </nav>
      </article>
    </div>
  </main>
</MainSpaceLayout>

<script>
  import { initWorkDoc } from '../scripts/work-doc';

  initWorkDoc();
</script>
