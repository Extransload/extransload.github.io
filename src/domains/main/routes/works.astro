---
import MainSpaceLayout from '../layouts/MainSpaceLayout.astro';
import ChapterIsland from '../../../shared/components/ChapterIsland.astro';
import WorkIcon from '../components/WorkIcon.astro';
import { works, patents } from '../data/work-archive';

import '../../../shared/styles/paper-page.css';
import '../../../shared/styles/editorial-surfaces.css';
import '../styles/works.css';
---

<MainSpaceLayout title="Works — Extransload" description="문제를 제품으로 바꾸며 쌓아 온 Extransload의 작업 기록" canonicalPath="/works/">
  <ChapterIsland current="works" />
  <main class="paper-page works-page" aria-labelledby="works-title" data-works-scroll data-works-view="index">
    <div class="paper-page__column">
      <header class="paper-page__intro">
        <p class="paper-page__kicker works-kicker">Liber II · A record of making</p>
        <h1 id="works-title" class="paper-page__lede"><span class="sr-only">Works — </span>그동안 진행한 프로젝트 {works.length}개를 정리했습니다.</h1>
        <nav class="paper-page__jump" aria-label="이 페이지">
          <a href="#works-contents-title">작업 목록</a>
          <a href="#works-patents-title">출원 특허</a>
        </nav>
      </header>

      <section class="paper-page__section works-contents" aria-labelledby="works-contents-title">
        <h2 id="works-contents-title" class="paper-page__section-title">작업 목록 · {String(works.length).padStart(2, '0')}</h2>

        <ol class="works-index">
          {works.map((project) => (
            <li class="works-index__item" data-works-card>
              <a class="works-index__link editorial-surface" href={`/works/${project.slug}/`} aria-labelledby={`folio-${project.slug}`}>
                <span class="works-index__cover" data-project={project.slug}>
                  <img class="works-index__logo" src={project.logo.src} alt={project.slug === 'citewell' ? '' : project.logo.alt} loading="lazy" decoding="async" width={project.logo.width ?? 900} height={project.logo.height ?? 506} />
                  {project.slug === 'citewell' && <span class="works-index__cover-wordmark" aria-hidden="true">CiteWell</span>}
                  {project.slug === 'tablepeek' && <span class="works-index__cover-wordmark works-index__cover-wordmark--tablepeek" aria-hidden="true">Table<em>Peek</em></span>}
                </span>
                <span class="works-index__body">
                  <span class="paper-page__meta">
                    <span class="paper-page__accent works-index__folio">{project.folio}</span>
                    <span aria-hidden="true">·</span>
                    <span class="works-index__period">{project.period}</span>
                  </span>
                  <span class="works-index__heading">
                    <span class="works-index__name" id={`folio-${project.slug}`}>{project.title}</span>
                    <span class="works-index__subtitle">{project.subtitle}</span>
                  </span>
                  <span class="works-index__role">{project.context} · {project.role}</span>
                  <span class="works-index__metrics">
                    {project.metrics.map((metric) => (
                      <span class="works-index__metric"><span class="works-index__metric-label">{metric.label}</span><b>{metric.value}</b></span>
                    ))}
                  </span>
                </span>
              </a>
            </li>
          ))}
        </ol>
      </section>

      <section class="paper-page__section works-patents" aria-labelledby="works-patents-title">
        <h2 id="works-patents-title" class="paper-page__section-title">출원 특허 · {String(patents.length).padStart(2, '0')}</h2>
        <p class="paper-page__note">국내에 같은 기능의 제품이 없어, 두 프로그램을 각각 별도 출원했습니다.</p>
        <ul class="works-patents__list">
          {patents.map((patent) => (
            <li class="works-patents__item editorial-surface">
              <p class="paper-page__meta works-patents__scope"><WorkIcon name="patent" /><span class="paper-page__accent">특허 · {patent.scope}</span></p>
              <p class="works-patents__title">{patent.title}</p>
              <p class="works-patents__detail">{patent.note}</p>
            </li>
          ))}
        </ul>
      </section>

      <p class="paper-page__note works-colophon">프로젝트 기간과 기능 연대기는 업무 기록, 각 프로젝트 저장소의 커밋과 문서를 바탕으로 정리했습니다.</p>

      <footer class="paper-page__footer">© {new Date().getFullYear()} Extransload</footer>
    </div>
  </main>
</MainSpaceLayout>

<script>
  import { initWorksScroll } from '../scripts/works';

  initWorksScroll();
</script>
