---
import '../renju/playroom.css';
import SeoHead from '../../../shared/components/SeoHead.astro';
const apiUrl = import.meta.env.PUBLIC_RENJU_API_URL ?? '';
---

<!doctype html>
<html lang="ko">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#101e2d" />
    <title>Playroom — Extransload</title>
    <SeoHead title="Playroom — Extransload" description="Extransload Playroom의 실시간 3D 렌주 대국" canonicalPath="/playroom/" />
    <link rel="icon" type="image/png" href="/favicon.png" />
  </head>
  <body data-api-url={apiUrl}>
    <header class="top"><a href="/playroom/" aria-label="Playroom 홈">Playroom</a><a class="top-home" href="/" aria-label="홈으로">⌂</a></header>
    <main class="game">
      <section class="stage" aria-label="3D 렌주 바둑판">
        <div class="toolbar" role="toolbar" aria-label="바둑판 조작">
          <button id="view" title="위에서 보기" aria-label="위에서 보기">▦</button>
          <button id="zoom-in" title="확대" aria-label="확대">＋</button>
          <button id="zoom-out" title="축소" aria-label="축소">−</button>
          <button id="reset" title="시점 초기화" aria-label="시점 초기화">↺</button>
          <button id="rules" title="렌주 규칙" aria-label="렌주 규칙">☷</button>
          <button id="help" title="조작 방법" aria-label="조작 방법">?</button>
        </div>
        <div id="canvas" class="canvas"></div>
        <div id="forbidden-tip" class="forbidden-tip" hidden></div>
        <div id="board-help" class="board-help" hidden>드래그: 회전<br />휠 · 두 손가락: 확대<br />우클릭 · 두 손가락 이동: 이동</div>
        <div id="stage-hint" class="stage-hint">첫 수는 중앙에서 시작합니다</div>
      </section>
      <aside class="side">
        <div class="side-top"><span id="connection-dot" class="connection-dot"></span><span id="status" role="status">연결 준비 중</span></div>
        <div class="players">
          <div id="black-player" class="player"><span class="piece black"></span><div><strong id="black-name">흑</strong><small id="black-detail">대기 중</small></div></div>
          <div id="white-player" class="player"><span class="piece white"></span><div><strong id="white-name">백</strong><small id="white-detail">대기 중</small></div></div>
        </div>
        <div id="lobby" class="lobby"><button id="create" class="primary">새 대국 만들기</button><button id="join" class="primary" hidden>대국 참여하기</button><p id="lobby-note"></p></div>
        <div id="replay" class="replay" hidden><div class="replay-title"><span>기보</span><span id="move-count">0 / 0</span></div><div class="replay-controls"><button id="prev" title="이전 수" aria-label="이전 수">‹</button><strong id="move-label">시작</strong><button id="next" title="다음 수" aria-label="다음 수">›</button></div></div>
        <div class="side-spacer"></div>
        <button id="share" class="primary" hidden><span aria-hidden="true">↗</span> 초대 링크 복사</button>
        <button id="resign" class="secondary" hidden>기권</button>
        <button id="new-game" class="secondary" hidden>새 대국</button>
      </aside>
    </main>
    <dialog id="rules-dialog" class="rules-dialog" aria-labelledby="rules-title"><button id="rules-close" class="dialog-close" aria-label="닫기">×</button><div class="rules-heading"><h2 id="rules-title">렌주 규칙</h2><span id="rules-count"></span></div><div id="rules-visual" class="rules-visual" role="img"></div><span id="rules-tag" class="rules-tag"></span><h3 id="rules-slide-title"></h3><p id="rules-slide-body"></p><div class="rules-nav"><button id="rules-prev" aria-label="이전 규칙">‹</button><div id="rules-dots" class="rules-dots"></div><button id="rules-next" aria-label="다음 규칙">›</button></div><a class="rules-source" href="https://gomoku.renju.net/rifrules/" target="_blank" rel="noopener noreferrer">RIF 공식 규칙 ↗</a></dialog>
    <script>
      import '../renju/playroom';
    </script>
  </body>
</html>
