<section class="wardrobe" aria-label="무료 꾸미기 옷장">
  <div class="wardrobe-heading"><strong>무료 옷장</strong><small>모든 디자인 사용 가능</small></div>
  <div class="wardrobe-preview" aria-hidden="true"><span class="wardrobe-preview-avatar"></span><span class="wardrobe-preview-board"><i></i><i></i></span></div>
  <div class="wardrobe-grid">
    <label>돌 재질<select data-wardrobe="stone"><option value="classic">기본 유광</option><option value="jade">비취</option><option value="slate">먹돌</option></select></label>
    <label>아바타<select data-wardrobe="avatar"><option value="classic">기본</option><option value="coral">산호</option><option value="mint">민트</option></select></label>
    <label>바둑판<select data-wardrobe="board"><option value="oak">참나무</option><option value="walnut">호두나무</option><option value="linen">린넨</option></select></label>
    <label>승리 연출<select data-wardrobe="victory"><option value="dance">춤추기</option><option value="spin">회전하기</option></select></label>
  </div>
</section>
