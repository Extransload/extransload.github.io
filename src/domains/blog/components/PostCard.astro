---
import type { CollectionEntry } from 'astro:content';
import { getPostSlug } from '../content/post-slug';

interface Props {
  post: CollectionEntry<'posts'>;
}

const { post } = Astro.props;
const slug = getPostSlug(post);
const { category, description, pubDate, title } = post.data;
// The site publishes in KST. Local-timezone getters would shift the day
// whenever the build machine runs elsewhere, and CI builds in UTC.
const date = new Intl.DateTimeFormat('en-CA', {
  timeZone: 'Asia/Seoul',
  year: 'numeric',
  month: '2-digit',
  day: '2-digit',
})
  .format(pubDate)
  .replace(/-/g, '.');
const categoryHref = `/blog/categories/${encodeURIComponent(category)}/`;
---

<li class="post-card">
  <article>
    <div class="post-card__meta">
      <a href={categoryHref}>{category}</a>
      <span aria-hidden="true">·</span>
      <time datetime={pubDate.toISOString()}>{date}</time>
    </div>
    <div class="post-card__copy">
      <h3><a href={`/blog/posts/${slug}/`}>{title}</a></h3>
      <p>{description}</p>
    </div>
  </article>
</li>
